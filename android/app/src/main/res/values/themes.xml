<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SwaraGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App Bar -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondary">@color/onSecondary</item>

        <!-- Status colors for risk levels -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>

        <!-- Risk colors -->
        <item name="colorSecondary50">@color/risk_medium</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SwaraGuard.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SwaraGuard.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SwaraGuard.LargeComponent</item>
    </style>

    <style name="Theme.SwaraGuard.NoActionBar" parent="Theme.SwaraGuard" />

    <!-- Shape appearances -->
    <style name="ShapeAppearance.SwaraGuard.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SwaraGuard.MediumComponent" parent="ShapeAppearance.SwaraGuard.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SwaraGuard.LargeComponent" parent="ShapeAppearance.SwaraGuard.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
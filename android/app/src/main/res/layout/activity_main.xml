<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvRiskLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk Level: LOW"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="32px" />

        <TextView
            android:id="@+id/tvRiskScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk Score: 0%"
            app:layout_constraintTop_toBottomOf="@id/tvRiskLevel"
            android:layout_marginTop="16px" />

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16px"
            android:background="#1e293b"
            android:text="No analysis yet"
            app:layout_constraintTop_toBottomOf="@id/tvRiskScore"
            app:layout_constraintBottom_toTopOf="@id/btnStart"
            android:layout_margin="8px" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Monitoring"
            app:layout_constraintTop_toBottomOf="@id/tvTranscript"
            android:layout_marginTop="16px" />

        <Button
            android:id="@+id/btnDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demo Mode"
            app:layout_constraintTop_toBottomOf="@id/btnStart"
            android:layout_marginTop="16px" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="24px" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>